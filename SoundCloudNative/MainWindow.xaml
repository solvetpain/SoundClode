<Window x:Class="SoundCloudNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SoundCloud"
        Height="760" Width="1160"
        MinHeight="480" MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="8" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Seamless dynamic border with Mica glass translucency -->
    <Border x:Name="mainBorder" Background="#C007080A" BorderBrush="#20222B" BorderThickness="1" ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minimalist integrated drag bar -->
            <Grid x:Name="titleBarGrid" Grid.Row="0" Background="#9007080A" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Window action buttons on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btnMinimize" Click="BtnMinimize_Click" Content="—" Foreground="#717585" Background="Transparent" BorderThickness="0" Width="28" Height="22" Cursor="Hand" FontSize="12"/>
                    <Button x:Name="btnMaximize" Click="BtnMaximize_Click" Content="🗖" Foreground="#717585" Background="Transparent" BorderThickness="0" Width="28" Height="22" Cursor="Hand" FontSize="11" Margin="2,0,0,0"/>
                    <Button x:Name="btnClose" Click="BtnClose_Click" Content="✕" Foreground="#717585" Background="Transparent" BorderThickness="0" Width="28" Height="22" Cursor="Hand" FontSize="12" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Embedded Web Player -->
            <wv2:WebView2 Grid.Row="1" x:Name="webView"/>
            <!-- Hidden background sync worker for real-time SoundCloud likes and session DataDome -->
            <Grid Grid.Row="1" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <wv2:WebView2 x:Name="bgSyncWebView"/>
            </Grid>
        </Grid>
    </Border>
</Window>
